# FitConnect — environment variables (copy to .env.local)

# Phase 1 — Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:pass@host/fitconnect?sslmode=require"

# Phase 1 — Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Demo mode keeps hardcoded demo login when true
NEXT_PUBLIC_DEMO_MODE="true"

# Phase 2 — Realtime (broadcast | convex | supabase)
NEXT_PUBLIC_REALTIME_PROVIDER="convex"
NEXT_PUBLIC_CONVEX_URL="https://striped-quail-172.convex.cloud"
# Dev deployment (local `pnpm convex:dev`) — auto-written by Convex CLI:
# CONVEX_DEPLOYMENT=dev:valuable-camel-828
# CONVEX_SITE_URL=https://valuable-camel-828.convex.site

# Phase 2 — LiveKit video
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://your-livekit-host"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-livekit-host"

# Phase 3 — Wearables (OAuth app credentials)
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_WEBHOOK_VERIFY_TOKEN="fitconnect-dev"
STRAVA_TOKEN_ENCRYPTION_KEY=""
GARMIN_CONSUMER_KEY=""
GARMIN_CONSUMER_SECRET=""

# Phase 3 — Temporal
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="fitconnect"

# Phase 5 — AI
OPENAI_API_KEY=""
LANGGRAPH_API_URL=""

# Phase 6 — Maps
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Observability
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Cache / queue (Phase 1+)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
INTEGRATION_AUTH_SECRET=""
STRAVA_OAUTH_STATE_SECRET=""
