# FitConnect — environment variables (copy to .env.local)
# Quick start:  pnpm env:setup-prod   then paste keys from dashboards
# Validate:     pnpm env:check

# ── Supabase (project: beuiammeedpovdkmhluw) ──
# https://supabase.com/dashboard/project/beuiammeedpovdkmhluw/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://beuiammeedpovdkmhluw.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Supabase Connect → ORM → Prisma → .env.local tab
# App runtime (Vercel + local dev) — Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.beuiammeedpovdkmhluw:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI only (pnpm db:migrate) — direct connection, port 5432 (user is `postgres`, not pooler prefix)
DIRECT_URL="postgresql://postgres:PASSWORD@db.beuiammeedpovdkmhluw.supabase.co:5432/postgres"

# Production: false enables Supabase auth + live integrations
NEXT_PUBLIC_DEMO_MODE="false"
NEXT_PUBLIC_APP_URL="https://fitconnect-phi.vercel.app"

# Phase 2 — Realtime (broadcast | convex | supabase)
NEXT_PUBLIC_REALTIME_PROVIDER="convex"
NEXT_PUBLIC_CONVEX_URL="https://striped-quail-172.convex.cloud"

# Phase 2 — LiveKit video
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://your-livekit-host"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-livekit-host"

# Phase 3 — Wearables (OAuth app credentials)
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Use same value in Strava webhook subscription + FitConnect env
STRAVA_WEBHOOK_VERIFY_TOKEN=""
# Run pnpm env:setup-prod to auto-generate:
STRAVA_TOKEN_ENCRYPTION_KEY=""
STRAVA_OAUTH_STATE_SECRET=""
GARMIN_CONSUMER_KEY=""
GARMIN_CONSUMER_SECRET=""

# Phase 3 — Temporal
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="fitconnect"

# Phase 5 — AI
OPENAI_API_KEY=""
LANGGRAPH_API_URL=""

# Phase 6 — Maps (OpenFreeMap — free, no API key)
# NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/dark"

# Phase 6 — Stripe (live when STRIPE_SECRET_KEY is set; demo fallback otherwise)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
#
# Local testing with Stripe CLI:
#   pnpm dev                 # terminal 1 — app on :3001
#   pnpm stripe:listen       # terminal 2 — copy whsec_… → STRIPE_WEBHOOK_SECRET
#   pnpm stripe:trigger      # terminal 3 — sample events
# Or: stripe login && stripe trigger payment_intent.succeeded

# Observability
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Media — ImageKit CDN (optional; enables next/image custom loader)
# https://imagekit.io/dashboard
NEXT_PUBLIC_IMAGEKIT_URL="https://ik.imagekit.io/your-id"
NEXT_PUBLIC_IMAGEKIT_PATH="/fitconnect"

# Cache / queue — https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
INTEGRATION_AUTH_SECRET=""

# Strava OAuth redirect (register in Strava API settings):
# {NEXT_PUBLIC_APP_URL}/api/v1/integrations/strava/callback
# Webhook: {NEXT_PUBLIC_APP_URL}/api/v1/integrations/strava/webhook
