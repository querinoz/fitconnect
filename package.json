{
  "name": "fitconnect",
  "version": "1.0.0",
  "private": true,
  "description": "FitConnect monorepo — web + mobile + shared packages",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev --filter=@fitconnect/web",
    "dev:mobile": "pnpm --filter @fitconnect/mobile start",
    "build": "turbo build",
    "postinstall": "prisma generate",
    "start": "pnpm --filter @fitconnect/web start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:strava": "pnpm --filter @fitconnect/strava-integration test",
    "test:e2e": "pnpm --filter @fitconnect/web test:e2e",
    "test:e2e:voltline": "pnpm --filter @fitconnect/web test:e2e:voltline",
    "test:coverage": "pnpm --filter @fitconnect/web test:coverage",
    "deploy:vercel": "pnpm dlx vercel@latest",
    "deploy:vercel:prod": "pnpm dlx vercel@latest --prod",
    "vercel:link": "pnpm dlx vercel@latest link",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy --yes",
    "convex:setup": "convex dev --once --configure new --team eduardooquerino --project fitconnect --dev-deployment cloud",
    "convex:accept-tos": "node scripts/convex-accept-tos.mjs",
    "audit:mobile": "pnpm --filter @fitconnect/web audit:mobile",
    "smoke": "pnpm --filter @fitconnect/web smoke",
    "smoke:mobile": "node scripts/mobile-pwa-check.mjs http://localhost:3001",
    "smoke:all": "pnpm smoke && pnpm smoke:mobile",
    "env:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-start.ps1",
    "env:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-setup.ps1",
    "env:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-stop.ps1",
    "env:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-clean.ps1",
    "env:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-status.ps1",
    "env:setup-prod": "node scripts/setup-production-env.mjs",
    "env:check": "node scripts/validate-env.mjs",
    "brand:logo": "node scripts/recolor-logo.mjs",
    "stripe:login": "stripe login",
    "stripe:whsec": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stripe-print-whsec.ps1",
    "stripe:whsec:save": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stripe-print-whsec.ps1 -Save",
    "stripe:listen": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stripe-webhook-dev.ps1",
    "stripe:trigger": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stripe-trigger-events.ps1"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "convex": "^1.39.1",
    "prisma": "^7.8.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.2",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
