# FitConnect test environment — copy to .env.test and adjust locally
DATABASE_URL=postgresql://fitconnect:fitconnect_test@localhost:5433/fitconnect_test
DIRECT_URL=postgresql://fitconnect:fitconnect_test@localhost:5433/fitconnect_test
REDIS_URL=redis://localhost:6380
STRIPE_WEBHOOK_SECRET=whsec_test_replace_me
STRIPE_WEBHOOK_PROCESSING=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_REALTIME_PROVIDER=broadcast
PACT_BROKER_URL=http://localhost:9292
PACT_PROVIDER_URL=http://localhost:3001
RUN_DB_TESTS=1
RUN_PACT_VERIFY=1
K6_TEST_EMAIL=demo@fitconnect.app
K6_TEST_PASSWORD=demo-password
STRAVA_PROACTIVE_REFRESH=true
