<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG / LOCAL_DEMO: do not auto-init Firebase or register FCM receivers.
  google-services.json is absent in typical LOCAL_DEMO builds; FirebaseInitProvider
  and messaging components must not run at process start.

  Release keeps main-manifest FCM + google-services plugin (fail-closed when missing).
  If you add google-services.json for debug FCM experiments, remove or gate this overlay.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service
            android:name="com.fitconnect.android.push.FitConnectFirebaseMessagingService"
            tools:node="remove" />

        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            tools:node="remove" />

        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            tools:node="remove" />

        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            tools:node="remove" />
    </application>
</manifest>
