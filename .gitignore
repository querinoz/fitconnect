node_modules/
.next/
out/
build/
dist/
.env*.local
.firebase/
users.json
.vercel
*.tsbuildinfo
next-env.d.ts
.dev.out.log
.dev.err.log
.fitconnect/
.superpowers/
.worktrees/
.artifacts/
playwright-report/
test-results/
/coverage/
**/coverage/
.turbo/
**/.turbo/

# Generated PWA service worker (production build only — breaks dev if cached)
apps/web/public/sw.js
apps/web/public/workbox-*.js

# Rust (elite-core, ADR-006) — Cargo.lock IS committed (reproducible builds
# across JNI/wasm/napi targets), only build output is ignored.
elite-core/target/
**/*.rs.bk

# Android (ADR-005) — standard Gradle/Android ignores, added ahead of the
# android/ scaffold so it's never accidentally committed once it lands.
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/*/build/
android/local.properties
android/.cxx/
android/keystore.properties
*.keystore
!debug.keystore
*.jks
android/*.jks
android/app/*.jks
android/app/google-services.json
android/local.properties
android/.auth-qa/

functions/node_modules/
functions/lib/
*.service-account.json
**/firebase-adminsdk*.json
.fitconnect-local-distribution/

# Python caches (QR / brand scripts)
**/__pycache__/
**/*.pyc

# Expo local cache (apps/mobile is frozen Path A)
apps/mobile/.expo/

# QA machine logs — keep markdown audits, never commit Gradle/dev tails
qa/reports/*.log
qa/reports/*.pid
qa/reports/*-selftest.json

# Binary packages accidentally dropped at repo root
/*.apk
/*.aab

